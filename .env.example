# Chibi Avatar Maker environment variables
#
# Version 1 (this MVP) runs entirely client-side and needs no secrets.
# These are reserved for the future backend-mediated AI features
# (see README.md "今後の拡張"). Never put API keys directly in frontend
# code — they must only be read by a backend service.

# Future: backend endpoint used by the AI image analysis feature (V2)
VITE_AI_BACKEND_URL=

# Future: Supabase project (cloud save / accounts, V2+)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
